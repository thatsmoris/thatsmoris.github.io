---
const name = "Akampurira Moris";
const tagline = "Math &times; Code &times; Markets";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Akampurira Moris &mdash; mathematics, programming, markets, and quantitative finance."
    />
    <title>{name} &mdash; Quantitative Finance</title>
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/">AM<span>.</span></a>

      <nav>
        <a href="#now">NOW</a>
        <a href="#compete">COMPETE</a>
        <a href="#research">RESEARCH</a>
        <a href="#build">BUILD</a>
        <a href="#vision">VISION</a>
      </nav>
    </header>

    <main>
      <section class="hero">
  <div class="hero-top">
    <span>AKAMPURIRA MORIS</span>
    <span>QUANTITATIVE FINANCE</span>
  </div>

  <div class="hero-slider" data-slider>
    <article class="hero-slide is-active">
      <p class="slide-index">01 / 04</p>

      <p class="eyebrow">MATH &times; CODE &times; MARKETS</p>

      <h1>
        Quantitative<br />
        <span>finance.</span>
      </h1>

      <p class="hero-statement">
        One obsession. One direction.
      </p>
    </article>

    <article class="hero-slide">
      <p class="slide-index">02 / 04</p>

      <p class="eyebrow">THE MIND</p>

      <h1>
        First<br />
        <span>principles.</span>
      </h1>

      <p class="hero-statement">
        Don't cram. Understand.
      </p>
    </article>

    <article class="hero-slide">
      <p class="slide-index">03 / 04</p>

      <p class="eyebrow">THE ARENA</p>

      <h1>
        Compete.<br />
        <span>Build. Research.</span>
      </h1>

      <p class="hero-statement">
        Mathematics. Programming. Markets. Evidence.
      </p>
    </article>

    <article class="hero-slide">
      <p class="slide-index">04 / 04</p>

      <p class="eyebrow">THE VISION</p>

      <h1>
        Building<br />
        <span>toward scale.</span>
      </h1>

      <p class="hero-statement">
        From mathematical foundations to exceptional quantitative systems.
      </p>
    </article>
  </div>

  <div class="hero-controls">
    <button type="button" class="slider-arrow" data-prev aria-label="Previous slide">
      &larr;
    </button>

    <div class="slide-progress">
      <button type="button" class="progress-item is-active" data-slide="0" aria-label="Slide 1"></button>
      <button type="button" class="progress-item" data-slide="1" aria-label="Slide 2"></button>
      <button type="button" class="progress-item" data-slide="2" aria-label="Slide 3"></button>
      <button type="button" class="progress-item" data-slide="3" aria-label="Slide 4"></button>
    </div>

    <button type="button" class="slider-arrow" data-next aria-label="Next slide">
      &rarr;
    </button>
  </div>

  <div class="hero-bottom">
    <span>S5 / MENGO SENIOR SCHOOL</span>
    <span>2026 / ACTIVE</span>
  </div>
</section>

      <section id="now" class="section now-section">
  <div class="section-heading">
    <p class="section-label">01 / NOW</p>

    <h2>
      Currently<br />
      <span>in the arena.</span>
    </h2>

    <p class="section-intro">
      The work is happening now. Mathematics, programming,
      competition, research, and the foundations for quantitative finance.
    </p>
  </div>

  <div class="now-list">
    <article class="now-item">
      <div class="now-number">01</div>

      <div class="now-main">
        <p class="now-category">MATHEMATICS</p>
        <h3>UMS MathContest</h3>
        <p>
          Paper II qualifier. Preparing for the Mathematics bootcamp
          and the road toward the national IMO team.
        </p>
      </div>

      <div class="now-result">
        <strong>147</strong>
        <span>/ 2,045 nationwide</span>
      </div>
    </article>

    <article class="now-item">
      <div class="now-number">02</div>

      <div class="now-main">
        <p class="now-category">PROGRAMMING</p>
        <h3>IISCC</h3>
        <p>
          Competitive programming and problem solving.
          Currently active.
        </p>
      </div>

      <div class="now-result">
        <strong>ACTIVE</strong>
        <span>competition season</span>
      </div>
    </article>

    <article class="now-item">
      <div class="now-number">03</div>

      <div class="now-main">
        <p class="now-category">ACADEMICS</p>
        <h3>Mengo Senior School</h3>
        <p>
          Senior 5. PEM / ICT. Mathematics remains the strongest
          subject and a central part of the quant path.
        </p>
      </div>

      <div class="now-result">
        <strong>S5</strong>
        <span>currently studying</span>
      </div>
    </article>
  </div>

  <div class="now-footer">
    <span>STATUS / ACTIVE</span>
    <a href="#compete">VIEW COMPETITION RECORD &rarr;</a>
  </div>
</section>

      <section id="compete" class="section compete-hybrid">
  <div class="hybrid-top">
    <p class="section-label">02 / COMPETE</p>

    <span class="hybrid-status">
      COMPETITIVE RECORD / 2026
    </span>
  </div>

  <div class="hybrid-intro">
    <h2>
      The arena<br />
      <span>keeps score.</span>
    </h2>

    <p>
      Competition is where theory meets pressure.
      Every result becomes another data point.
    </p>
  </div>

  <div class="hero-result">
    <div class="result-label">
      <span>UMS MATHCONTEST</span>
      <span>PAPER II / 2026</span>
    </div>

    <div class="result-number">
      <strong>147</strong>
      <span>/ 2,045</span>
    </div>

    <div class="result-description">
      <strong>NATIONWIDE</strong>

      <p>
        Qualified for the mathematics bootcamp from which
        the national IMO team is selected.
      </p>
    </div>
  </div>

  <div class="secondary-results">
    <article>
      <div class="secondary-top">
        <span>02</span>
        <span>PROGRAMMING</span>
      </div>

      <h3>IISCC</h3>

      <div class="secondary-bottom">
        <strong>ACTIVE</strong>
        <span>2026</span>
      </div>
    </article>

    <article>
      <div class="secondary-top">
        <span>03</span>
        <span>NEXT</span>
      </div>

      <h3>More to come.</h3>

      <div class="secondary-bottom">
        <strong>OPEN</strong>
        <span>&mdash;</span>
      </div>
    </article>
  </div>

  <div class="hybrid-footer">
    <span>RESULTS ARE DATA.</span>
    <span>THE NEXT ATTEMPT IS THE EXPERIMENT. &rarr;</span>
  </div>
</section>

      <section id="research" class="section research">
        <p class="section-label">03 / RESEARCH</p>

        <div class="research-header">
          <div>
            <h2>RIIS</h2>
            <p>REALISM INVESTING INTELLIGENCE SYSTEM</p>
          </div>

          <span class="status">
            &bull; RESEARCH IN PROGRESS
          </span>
        </div>

        <p class="research-description">
          A primary-source investment research framework designed to
          investigate capital cycles, infrastructure, and constraint-driven
          inflection points through structured analysis of company-level
          economic and operational data.
        </p>

        <div class="research-meta">
          <span>MICROSOFT</span>
          <span>AMAZON</span>
          <span>2016 &mdash; 2026</span>
          <span>PRIMARY SOURCES</span>
        </div>
      </section>

      <section id="build" class="section">
        <p class="section-label">04 / BUILD</p>

        <h2>
          The work<br />
          <span>is accumulating.</span>
        </h2>

        <div class="build-card">
          <span>SOFTWARE / 001</span>

          <h3>WEEPA</h3>

          <p>
            Active software project. More details coming as the project
            develops.
          </p>
        </div>

        <div class="build-card">
          <span>RESEARCH / 002</span>

          <h3>RIIS</h3>

          <p>
            Investment research framework exploring capital cycles and
            physical constraints.
          </p>
        </div>
      </section>

      <section id="vision" class="section vision">
        <p class="section-label">05 / VISION</p>

        <h2>
          Know what<br />
          <span>you want.</span>
        </h2>

        <p class="vision-text">
          Build the mathematical, computational, and research foundations
          required to create exceptional quantitative systems.
        </p>

        <p class="principle">
          The ambition is large.<br />
          The work begins with the next problem.
        </p>
      </section>
    </main>

    <footer>
      <span>AKAMPURIRA MORIS</span>
      <span>MATH &times; CODE &times; MARKETS</span>
    </footer>
  </body>
</html>

<style>
.compete-hybrid {
  min-height: auto;
}

.hybrid-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hybrid-status {
  color: #555;

  font-family: monospace;
  font-size: 0.65rem;
  letter-spacing: 0.08em;
}

.hybrid-intro {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 60px;

  margin: 60px 0 100px;
}

.hybrid-intro h2 {
  margin: 0;
}

.hybrid-intro p {
  align-self: end;

  max-width: 350px;

  margin: 0;

  color: #777;

  line-height: 1.7;
}

.hero-result {
  display: grid;
  grid-template-columns: 1fr 2fr 1fr;
  gap: 40px;

  padding: 45px 0;

  border-top: 1px solid #444;
  border-bottom: 1px solid #303030;
}

.result-label {
  display: flex;
  flex-direction: column;
  gap: 8px;

  color: #666;

  font-family: monospace;
  font-size: 0.65rem;
  letter-spacing: 0.08em;
}

.result-number {
  display: flex;
  align-items: baseline;
  gap: 15px;
}

.result-number strong {
  font-family: monospace;
  font-size: clamp(5rem, 10vw, 9rem);
  font-weight: 400;
  line-height: 0.8;
  letter-spacing: -0.08em;
}

.result-number span {
  color: #555;

  font-family: monospace;
  font-size: 1rem;
}

.result-description {
  align-self: end;

  border-left: 1px solid #303030;

  padding-left: 25px;
}

.result-description strong {
  font-family: monospace;
  font-size: 0.7rem;
  letter-spacing: 0.1em;
}

.result-description p {
  margin: 12px 0 0;

  color: #777;

  font-size: 0.85rem;
  line-height: 1.6;
}

.secondary-results {
  display: grid;
  grid-template-columns: 1fr 1fr;
}

.secondary-results article {
  padding: 30px 0;

  border-bottom: 1px solid #303030;
}

.secondary-results article + article {
  border-left: 1px solid #303030;
  padding-left: 30px;
}

.secondary-top,
.secondary-bottom {
  display: flex;
  justify-content: space-between;

  color: #555;

  font-family: monospace;
  font-size: 0.65rem;
  letter-spacing: 0.06em;
}

.secondary-results h3 {
  margin: 55px 0;

  font-size: 1.8rem;
  font-weight: 400;
}

.secondary-bottom strong {
  color: #aaa;
  font-weight: 400;
}

.hybrid-footer {
  display: flex;
  justify-content: space-between;

  margin-top: 25px;

  color: #555;

  font-family: monospace;
  font-size: 0.6rem;
  letter-spacing: 0.06em;
}
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #0a0a0a;
    color: #f2f2f2;
    font-family: Arial, Helvetica, sans-serif;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 24px 32px;

    border-bottom: 1px solid #202020;

    background: rgba(10, 10, 10, 0.82);

    backdrop-filter: blur(12px);
  }

  .brand {
    color: #f2f2f2;
    font-family: monospace;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .brand span {
    opacity: 0.45;
  }

  nav {
    display: flex;
    gap: 28px;
  }

  nav a {
    color: #888;
    font-family: monospace;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  nav a:hover {
    color: #fff;
  }
.hero {
  position: relative;
  min-height: 100vh;

  display: flex;
  flex-direction: column;
  justify-content: center;

  padding: 140px 0 110px;
}

.hero-top,
.hero-bottom {
  position: absolute;
  left: 0;
  right: 0;

  display: flex;
  justify-content: space-between;

  color: #555;

  font-family: monospace;
  font-size: 0.65rem;
  letter-spacing: 0.1em;
}

.hero-top {
  top: 110px;
}

.hero-bottom {
  bottom: 30px;
}

.hero-slider {
  position: relative;
  min-height: 560px;
  display: flex;
  align-items: center;
}

.hero-slide {
  position: absolute;
  inset: 0;

  display: flex;
  flex-direction: column;
  justify-content: center;

  opacity: 0;
  transform: translateY(25px);

  pointer-events: none;

  transition:
    opacity 0.55s ease,
    transform 0.55s ease;
}

.hero-slide.is-active {
  opacity: 1;
  transform: translateY(0);

  pointer-events: auto;
}

.slide-index {
  position: absolute;
  top: 0;
  right: 0;

  margin: 0;

  color: #555;

  font-family: monospace;
  font-size: 0.7rem;
}

.eyebrow {
  margin: 0 0 28px;

  color: #888;

  font-family: monospace;
  font-size: 0.75rem;
  letter-spacing: 0.16em;
}

.hero-slide h1 {
  max-width: 1100px;

  margin: 0;

  font-size: clamp(5rem, 12vw, 11rem);
  line-height: 0.82;
  letter-spacing: -0.075em;
}

.hero-slide h1 span {
  color: #555;
}

.hero-statement {
  max-width: 620px;

  margin: 55px 0 0;

  color: #999;

  font-size: clamp(1rem, 1.8vw, 1.25rem);
  line-height: 1.7;
}

.hero-controls {
  position: absolute;
  right: 0;
  bottom: 75px;

  display: flex;
  align-items: center;
  gap: 18px;
}

.slider-arrow {
  width: 38px;
  height: 38px;

  border: 1px solid #303030;

  background: transparent;

  color: #aaa;

  font-family: monospace;
  font-size: 1rem;

  cursor: pointer;

  transition:
    background 0.2s ease,
    color 0.2s ease;
}

.slider-arrow:hover {
  background: #f2f2f2;
  color: #0a0a0a;
}

.slide-progress {
  display: flex;
  align-items: center;
  gap: 7px;
}

.progress-item {
  width: 32px;
  height: 2px;

  padding: 0;

  border: 0;

  background: #333;

  cursor: pointer;

  transition:
    width 0.3s ease,
    background 0.3s ease;
}

.progress-item.is-active {
  width: 55px;
  background: #aaa;
}

  .intro {
    max-width: 580px;

    margin-bottom: 40px;

    color: #a0a0a0;

    font-size: 1.1rem;
    line-height: 1.7;
  }

  .actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .actions a {
    padding: 14px 20px;

    border: 1px solid #444;

    color: #f2f2f2;

    font-family: monospace;
    font-size: 0.8rem;

    text-decoration: none;

    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .actions a:hover {
    background: #f2f2f2;
    color: #0a0a0a;
  }

  .section {
    min-height: 80vh;

    padding: 140px 0;

    border-top: 1px solid #202020;
  }
.now-section {
  min-height: auto;
}

.section-heading {
  display: grid;
  grid-template-columns: 1fr 2fr;
  column-gap: 60px;
  align-items: start;
}

.section-heading .section-label {
  grid-column: 1;
}

.section-heading h2 {
  grid-column: 2;

  margin: 0 0 35px;
}

.section-intro {
  grid-column: 2;

  max-width: 560px;
  margin: 0 0 100px;

  color: #777;

  font-size: 1rem;
  line-height: 1.7;
}

.now-list {
  border-top: 1px solid #303030;
}

.now-item {
  display: grid;
  grid-template-columns: 70px 1fr 240px;
  gap: 40px;

  padding: 38px 0;

  border-bottom: 1px solid #303030;

  transition: padding 0.25s ease;
}

.now-item:hover {
  padding-left: 12px;
}

.now-number {
  color: #555;

  font-family: monospace;
  font-size: 0.7rem;
}

.now-category {
  margin: 0 0 12px;

  color: #666;

  font-family: monospace;
  font-size: 0.65rem;
  letter-spacing: 0.12em;
}

.now-main h3 {
  margin: 0 0 12px;

  font-size: 1.7rem;
  font-weight: 500;
  letter-spacing: -0.03em;
}

.now-main > p:last-child {
  max-width: 580px;
  margin: 0;

  color: #777;

  line-height: 1.6;
}

.now-result {
  display: flex;
  flex-direction: column;
  justify-content: center;

  border-left: 1px solid #303030;

  padding-left: 30px;
}

.now-result strong {
  color: #f2f2f2;

  font-family: monospace;
  font-size: 2rem;
  font-weight: 400;
  letter-spacing: -0.04em;
}

.now-result span {
  margin-top: 6px;

  color: #555;

  font-family: monospace;
  font-size: 0.65rem;
  letter-spacing: 0.05em;
}

.now-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-top: 30px;

  font-family: monospace;
  font-size: 0.65rem;
  letter-spacing: 0.08em;
}

.now-footer span {
  color: #555;
}

.now-footer a {
  color: #999;

  text-decoration: none;

  transition: color 0.2s ease;
}

.now-footer a:hover {
  color: #fff;
}
  .section-label {
    margin: 0;

    color: #666;

    font-family: monospace;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .section h2 {
    max-width: 900px;

    margin: 30px 0 80px;

    font-size: clamp(3.5rem, 8vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .now-grid,
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

    border-top: 1px solid #303030;
  }

  .now-grid > div,
  .stat {
    padding: 30px;

    border-right: 1px solid #303030;
  }

  .now-grid span {
    color: #555;

    font-family: monospace;
  }

  .now-grid h3 {
    margin: 70px 0 10px;

    font-family: monospace;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }

  .now-grid p,
  .stat span {
    color: #777;
    line-height: 1.6;
  }

  .stat strong {
    display: block;

    margin-bottom: 15px;

    font-family: monospace;
    font-size: clamp(1.8rem, 4vw, 3.5rem);
    font-weight: 400;
  }

  .research-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 30px;
  }

  .research-header h2 {
    margin-bottom: 10px;
  }

  .research-header p {
    margin: 0;

    color: #777;

    font-family: monospace;
    font-size: 0.75rem;
  }

  .status {
    color: #888;

    font-family: monospace;
    font-size: 0.7rem;
  }

  .research-description {
    max-width: 750px;

    margin: 80px 0;

    color: #aaa;

    font-size: clamp(1.2rem, 2vw, 1.6rem);
    line-height: 1.6;
  }

  .research-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .research-meta span {
    padding: 10px 14px;

    border: 1px solid #303030;

    font-family: monospace;
    font-size: 0.7rem;
  }

  .build-card {
    padding: 35px 0;

    border-top: 1px solid #303030;
  }

  .build-card span {
    color: #666;

    font-family: monospace;
    font-size: 0.7rem;
  }

  .build-card h3 {
    margin: 20px 0 10px;

    font-size: 2rem;
  }

  .build-card p {
    max-width: 600px;

    color: #777;
    line-height: 1.7;
  }

  .vision-text {
    max-width: 700px;

    color: #aaa;

    font-size: 1.5rem;
    line-height: 1.7;
  }

  .principle {
    margin-top: 120px;

    font-family: monospace;
    font-size: 1rem;
    line-height: 2;
  }

  footer {
    display: flex;
    justify-content: space-between;

    padding: 40px 32px;

    border-top: 1px solid #202020;

    color: #555;

    font-family: monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
  }

  @media (max-width: 700px) {
    .terminal-heading,
.hybrid-top {
  align-items: flex-start;
  flex-direction: column;
  gap: 20px;
}

.terminal-bar {
  display: none;
}

.terminal-row {
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.terminal-result {
  grid-column: 2;
}

.terminal-footer,
.hybrid-footer {
  align-items: flex-start;
  flex-direction: column;
  gap: 15px;
}

.hybrid-intro {
  display: block;
}

.hybrid-intro p {
  margin-top: 30px;
}

.hero-result {
  grid-template-columns: 1fr;
  gap: 40px;
}

.result-description {
